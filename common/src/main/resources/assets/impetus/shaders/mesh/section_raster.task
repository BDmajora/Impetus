#version 460
#extension GL_ARB_shading_language_include : enable
#extension GL_NV_mesh_shader : require
#extension GL_NV_gpu_shader5 : require

#import <impetus:mesh/scene.glsl>

// One workgroup per visible region: a meshlet per live section for the box test below, plus the indirect commands next frame's terrain draw and this frame's translucent draw consume
layout(local_size_x = 1) in;

taskNV out Task {
    // regionId << 8, the base of both the visibility bytes and the section headers
    uint32_t visibilityBase;
    uint32_t sectionBase;
    // Region-to-camera shift in sections, folded once here
    ivec3 chunkShift;
};

void main() {
    uint commandIndex = gl_WorkGroupID.x;
    // Regions arrive nearest first; translucency blends farthest first, so its commands are written mirrored
    uint translucentIndex = uint(regionCount) - gl_WorkGroupID.x - 1u;

    // A rejected region zeroes both commands, or next frame would replay whatever was there before
    if (regionVisibility[gl_WorkGroupID.x] == uint8_t(0)) {
        terrainCommandBuffer[commandIndex] = uvec2(0);
        translucencyCommandBuffer[translucentIndex] = uvec2(0);
        gl_TaskCountNV = 0;
        return;
    }

#ifdef STATISTICS_REGIONS
    atomicAdd(statisticsBuffer, 1u);
#endif

    uint32_t regionId = regionIndices[gl_WorkGroupID.x];
    Region data = regionData[regionId];
    int count = unpackRegionCount(data) + 1;

    visibilityBase = regionId << 8;
    sectionBase = regionId << 8;
    chunkShift = -cameraChunk.xyz;

    gl_TaskCountNV = count;

    // Meshlet count and the section id base, the uvec2 the terrain and translucent task shaders expect
    terrainCommandBuffer[commandIndex] = uvec2(uint32_t(count), visibilityBase);
    translucencyCommandBuffer[translucentIndex] = uvec2(uint32_t(count), visibilityBase);
}
