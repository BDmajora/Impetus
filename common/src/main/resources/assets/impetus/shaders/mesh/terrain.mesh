#version 460
#extension GL_ARB_shading_language_include : enable
#extension GL_NV_mesh_shader : require
#extension GL_NV_gpu_shader5 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#import <impetus:mesh/scene.glsl>
#import <impetus:mesh/vertex_format.glsl>
#import <impetus:mesh/cull.glsl>

// Quads to triangles, one thread per quad and sixteen per meshlet; triangles off screen or between pixel centres are dropped and a subgroup prefix sum places the survivors without atomics
layout(local_size_x = 16) in;
layout(triangles, max_vertices = 64, max_primitives = 32) out;

// Fog is the only interpolant; the fragment shader re-fetches everything else by quad id
layout(location = 1) out Interpolants {
    float fogAmount;
} OUT[];

taskNV in Task {
    vec3 origin;
    uint baseOffset;
    uint quadCount;

    uvec4 rangeEndA;
    uvec4 rangeEndB;
    uvec4 rangeStartA;
    uvec4 rangeStartB;
    float fade;
};

#import <impetus:mesh/quad_ranges.glsl>

// Position relative to the camera's section, which the MVP maps to clip space
vec3 relativePosition(Vertex v) {
    return decodeVertexPosition(v) + origin;
}

void emit(uint slot, Vertex v, vec4 clip) {
    gl_MeshVerticesNV[slot].gl_Position = clip;
    // A section still fading in shows that much more of the fog colour
    OUT[slot].fogAmount = 1.0 - fade * (1.0 - computeFog(relativePosition(v) + subChunkOffset.xyz, clip.w));
}

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        gl_PrimitiveCountNV = 0;
    }

    uint quad = resolveQuad(gl_GlobalInvocationID.x);

    if (quad == uint(-1)) {
        return;
    }

    // Vertices 0 and 2 are the diagonal both triangles share
    Vertex v0 = terrainData[(quad << 2) + 0u];
    Vertex v1 = terrainData[(quad << 2) + 1u];
    Vertex v2 = terrainData[(quad << 2) + 2u];
    Vertex v3 = terrainData[(quad << 2) + 3u];

    vec4 p0 = MVP * vec4(relativePosition(v0), 1.0);
    vec4 p1 = MVP * vec4(relativePosition(v1), 1.0);
    vec4 p2 = MVP * vec4(relativePosition(v2), 1.0);
    vec4 p3 = MVP * vec4(relativePosition(v3), 1.0);

    bool drawT0 = umbra_triangleVisible(p0, p1, p2, screenSize);
    bool drawT1 = umbra_triangleVisible(p2, p3, p0, screenSize);

    if (!(drawT0 || drawT1)) {
        return;
    }

    uint triangles = uint(drawT0) + uint(drawT1);
    uint triIndex = subgroupExclusiveAdd(triangles);
    uint vertBase = subgroupExclusiveAdd((drawT0 == drawT1) ? 4u : 3u);
    uint totalTriangles = subgroupMax(triIndex + triangles);

    uint indexCursor = triIndex * 3u;
    uint vertCursor = vertBase;

    emit(vertCursor++, v0, p0);
    emit(vertCursor++, v2, p2);

    // The primitive id carries the quad to re-fetch, the mip bias, the alpha cutoff selector and which triangle this is
    uint lodBias = hasMipmapping(v0) ? 0u : 1u;
    int payload = int((lodBias << 2) | rawAlphaCutoff(v0) | (quad << 4));

    if (drawT0) {
        emit(vertCursor, v1, p1);
        gl_PrimitiveIndicesNV[indexCursor++] = vertBase + 0u;
        gl_PrimitiveIndicesNV[indexCursor++] = vertCursor;
        gl_PrimitiveIndicesNV[indexCursor++] = vertBase + 1u;
        vertCursor++;

        gl_MeshPrimitivesNV[triIndex++].gl_PrimitiveID = payload | (0 << 3);
    }

    if (drawT1) {
        emit(vertCursor, v3, p3);
        gl_PrimitiveIndicesNV[indexCursor++] = vertBase + 1u;
        gl_PrimitiveIndicesNV[indexCursor++] = vertCursor;
        gl_PrimitiveIndicesNV[indexCursor++] = vertBase + 0u;
        vertCursor++;

        gl_MeshPrimitivesNV[triIndex++].gl_PrimitiveID = payload | (1 << 3);
    }

    if (subgroupElect()) {
        gl_PrimitiveCountNV = totalTriangles;
    }
}
