#version 460
#extension GL_ARB_shading_language_include : enable
#extension GL_NV_mesh_shader : require
#extension GL_NV_gpu_shader5 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#import <impetus:mesh/scene.glsl>
#import <impetus:mesh/vertex_format.glsl>
#import <impetus:mesh/cull.glsl>
#import <impetus:include/dynamic_light.glsl>

// Quads to triangles, two threads per quad and sixteen quads per meshlet, so a 32-lane warp is full; each thread transforms two corners and swaps them with its partner, triangles off screen or between pixel centres are dropped, and subgroup prefix sums place the survivors without atomics
layout(local_size_x = 32) in;
layout(triangles, max_vertices = 64, max_primitives = 32) out;

// Quads per meshlet; terrain.task's MESH_WORKLOAD
#define QUADS_PER_MESHLET 16u

// Fog and the moving-light level are the only interpolants; the fragment shader re-fetches everything else by quad id
layout(location = 1) out Interpolants {
    float fogAmount;
    float dynamicLight;
} OUT[];

taskNV in Task {
    vec3 origin;
    uint baseOffset;
    uint quadCount;

    uvec4 rangeEndA;
    uvec4 rangeEndB;
    uvec4 rangeStartA;
    uvec4 rangeStartB;
    float fade;
};

#import <impetus:mesh/quad_ranges.glsl>

// Position relative to the camera's section, which the MVP maps to clip space
vec3 relativePosition(Vertex v) {
    return decodeVertexPosition(v) + origin;
}

void emit(uint slot, Vertex v, vec4 clip) {
    gl_MeshVerticesNV[slot].gl_Position = clip;
    // A section still fading in shows that much more of the fog colour
    OUT[slot].fogAmount = 1.0 - fade * (1.0 - computeFog(relativePosition(v) + subChunkOffset.xyz, clip.w));
    // Measured from the render origin, which the light block is uploaded relative to
    OUT[slot].dynamicLight = impetus_dynamicLightLevel(relativePosition(v) + renderOffset.xyz);
}

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        gl_PrimitiveCountNV = 0;
    }

    // Both threads of a quad resolve the same quad, so a pair always leaves or stays together
    uint quad = resolveQuad(gl_WorkGroupID.x * QUADS_PER_MESHLET + (gl_LocalInvocationIndex >> 1));

    if (quad == uint(-1)) {
        return;
    }

    // The even thread holds corners 0 and 1, the odd one corners 2 and 3
    bool second = (gl_LocalInvocationIndex & 1u) != 0u;
    uint corner = second ? 2u : 0u;
    Vertex lead = terrainData[(quad << 2) + corner];
    Vertex next = terrainData[(quad << 2) + corner + 1u];

    vec4 leadClip = MVP * vec4(relativePosition(lead), 1.0);
    vec4 nextClip = MVP * vec4(relativePosition(next), 1.0);
    vec4 partnerLead = subgroupShuffleXor(leadClip, 1u);
    vec4 partnerNext = subgroupShuffleXor(nextClip, 1u);

    vec4 p0 = second ? partnerLead : leadClip;
    vec4 p1 = second ? partnerNext : nextClip;
    vec4 p2 = second ? leadClip : partnerLead;
    vec4 p3 = second ? nextClip : partnerNext;

    bool drawT0 = umbra_triangleVisible(p0, p1, p2, screenSize);
    bool drawT1 = umbra_triangleVisible(p2, p3, p0, screenSize);

    if (!(drawT0 || drawT1)) {
        return;
    }

    // Each thread owns one triangle: the even one (0,1,2), the odd one (2,3,0), the order terrain.frag reads barycentrics in
    bool owns = second ? drawT1 : drawT0;
    uint triIndex = subgroupExclusiveAdd(uint(owns));
    // Its lead corner always, its next corner only for its own triangle
    uint vertSlot = subgroupExclusiveAdd(owns ? 2u : 1u);
    uint partnerSlot = subgroupShuffleXor(vertSlot, 1u);
    uint totalTriangles = subgroupAdd(uint(owns));

    emit(vertSlot, lead, leadClip);

    // The primitive id carries the quad to re-fetch, the mip bias and alpha cutoff selector of corner 0, and which triangle this is
    uint material = (hasMipmapping(lead) ? 0u : 4u) | rawAlphaCutoff(lead);
    // Shuffled by both threads, since reading a lane that skipped the shuffle is undefined
    uint partnerMaterial = subgroupShuffleXor(material, 1u);
    uint quadMaterial = second ? partnerMaterial : material;
    int payload = int(quadMaterial | (quad << 4));

    if (owns) {
        emit(vertSlot + 1u, next, nextClip);
        gl_PrimitiveIndicesNV[triIndex * 3u + 0u] = vertSlot;
        gl_PrimitiveIndicesNV[triIndex * 3u + 1u] = vertSlot + 1u;
        gl_PrimitiveIndicesNV[triIndex * 3u + 2u] = partnerSlot;
        gl_MeshPrimitivesNV[triIndex].gl_PrimitiveID = payload | (second ? (1 << 3) : 0);
    }

    if (subgroupElect()) {
        gl_PrimitiveCountNV = totalTriangles;
    }
}
