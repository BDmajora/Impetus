#version 460
#extension GL_ARB_shading_language_include : enable
#extension GL_NV_mesh_shader : require
#extension GL_NV_gpu_shader5 : require

#import <impetus:mesh/scene.glsl>

// Opaque terrain, one workgroup per section: per-section backface culling by facing group, then enough meshlets of MESH_WORKLOAD quads to cover what survives
#define MESH_WORKLOAD 16

layout(local_size_x = 1) in;

taskNV out Task {
    // Section origin relative to the camera's section, in blocks
    vec3 origin;
    // First quad of this section in the geometry arena
    uint baseOffset;
    uint quadCount;
    // Surviving quad ranges as running end index and source offset; meshlet threads walk at most eight of them
    uvec4 rangeEndA;
    uvec4 rangeEndB;
    uvec4 rangeStartA;
    uvec4 rangeStartB;
};

void appendRange(inout uint slot, inout uint runningIndex, uint offset, uint count) {
    uint id = slot++;

    if (id < 4u) {
        rangeEndA[id] = runningIndex + count;
        rangeStartA[id] = offset;
    } else {
        rangeEndB[id - 4u] = runningIndex + count;
        rangeStartB[id - 4u] = offset;
    }

    runningIndex += count;
}

// The ranges are counts accumulated here into offsets, so a section can hold more quads than a 16-bit offset reaches
void selectRanges(ivec3 relativeChunk, uvec4 ranges) {
    uint slot = 0u;
    uint runningIndex = 0u;

    rangeEndA = uvec4(0);
    rangeEndB = uvec4(0);

    // The opaque groups start after the translucent quads
    uint cursor = (ranges.w >> 16) & 0xFFFFu;

    // A section level with the camera on an axis keeps both of its faces on that axis, hence <= and >=
    uint count = ranges.x & 0xFFFFu;
    if (relativeChunk.x <= 0 && count > 0u) { appendRange(slot, runningIndex, cursor, count); }
    cursor += count;

    count = (ranges.x >> 16) & 0xFFFFu;
    if (relativeChunk.y <= 0 && count > 0u) { appendRange(slot, runningIndex, cursor, count); }
    cursor += count;

    count = ranges.y & 0xFFFFu;
    if (relativeChunk.z <= 0 && count > 0u) { appendRange(slot, runningIndex, cursor, count); }
    cursor += count;

    count = (ranges.y >> 16) & 0xFFFFu;
    if (relativeChunk.x >= 0 && count > 0u) { appendRange(slot, runningIndex, cursor, count); }
    cursor += count;

    count = ranges.z & 0xFFFFu;
    if (relativeChunk.y >= 0 && count > 0u) { appendRange(slot, runningIndex, cursor, count); }
    cursor += count;

    count = (ranges.z >> 16) & 0xFFFFu;
    if (relativeChunk.z >= 0 && count > 0u) { appendRange(slot, runningIndex, cursor, count); }
    cursor += count;

    // Unassigned quads have no single facing, so they always draw
    appendRange(slot, runningIndex, cursor, ranges.w & 0xFFFFu);

    quadCount = runningIndex;
    gl_TaskCountNV = (runningIndex + MESH_WORKLOAD - 1u) / MESH_WORKLOAD;
}

// The main pass draws whatever was visible last frame; the temporal pass draws only what turned visible this frame (history bits 01)
bool shouldDraw(uint sectionId) {
    uint8_t history = sectionVisibility[sectionId];
#ifdef TEMPORAL
    return (history & uint8_t(3)) == uint8_t(1);
#else
    return (history & uint8_t(1)) != uint8_t(0);
#endif
}

void main() {
    uint sectionId = gl_WorkGroupID.x;

    if (!shouldDraw(sectionId)) {
        gl_TaskCountNV = 0;
        return;
    }

    ivec4 header = sectionData[sectionId].header;
    ivec3 chunk = unpackSectionChunk(header) - cameraChunk.xyz;

    origin = vec3(chunk << 4);
    baseOffset = uint(header.w);

    selectRanges(chunk, uvec4(sectionData[sectionId].renderRanges));

    // The temporal pass redraws sections the main pass already counted
#if defined(STATISTICS_SECTIONS) && !defined(TEMPORAL)
    atomicAdd(statisticsBuffer + 1, 1u);
#endif
#if defined(STATISTICS_QUADS) && !defined(TEMPORAL)
    atomicAdd(statisticsBuffer + 2, quadCount);
#endif
}
