#version 460
#extension GL_ARB_shading_language_include : enable
#extension GL_NV_mesh_shader : require
#extension GL_NV_gpu_shader5 : require

#import <impetus:mesh/scene.glsl>

// Opaque terrain, one workgroup per section: per-section backface culling by facing group, then enough meshlets of MESH_WORKLOAD quads to cover what survives
#define MESH_WORKLOAD 16

layout(local_size_x = 1) in;

taskNV out Task {
    // Section origin relative to the camera's section, in blocks
    vec3 origin;
    // First quad of this section in the geometry arena
    uint baseOffset;
    uint quadCount;
    // Surviving quad ranges as running end index and source offset; meshlet threads walk at most eight of them
    uvec4 rangeEndA;
    uvec4 rangeEndB;
    uvec4 rangeStartA;
    uvec4 rangeStartB;
    // How far the section has faded in
    float fade;
};

#import <impetus:mesh/task_ranges.glsl>

// The main pass draws whatever was visible last frame; the temporal pass draws only what turned visible this frame (history bits 01)
bool shouldDraw(uint sectionId) {
    uint8_t history = sectionVisibility[sectionId];
#ifdef TEMPORAL
    return (history & uint8_t(3)) == uint8_t(1);
#else
    return (history & uint8_t(1)) != uint8_t(0);
#endif
}

void main() {
    uint sectionId = gl_WorkGroupID.x;

    if (!shouldDraw(sectionId)) {
        gl_TaskCountNV = 0;
        return;
    }

    ivec4 header = sectionData[sectionId].header;
    ivec3 chunk = unpackSectionChunk(header) - cameraChunk.xyz;

    origin = vec3(chunk << 4);
    baseOffset = uint(header.w);
    fade = sectionFade(sectionId);

    selectRanges(header, chunk, uvec4(sectionData[sectionId].renderRanges), true);
    gl_TaskCountNV = (quadCount + MESH_WORKLOAD - 1u) / MESH_WORKLOAD;

    // The temporal pass redraws sections the main pass already counted
#if defined(STATISTICS_SECTIONS) && !defined(TEMPORAL)
    atomicAdd(statisticsBuffer + 1, 1u);
#endif
#if defined(STATISTICS_QUADS) && !defined(TEMPORAL)
    atomicAdd(statisticsBuffer + 2, quadCount);
#endif
}
