@@ -0,0 +1,41 @@
+package com.seibel.distanthorizons.forge112;
+
+import org.junit.jupiter.api.Test;
+
+import java.net.URL;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class DistantHorizonsMixinConnectorTest
+{
+	@Test
+	void irisApiFacadeDoesNotSuppressDhsDepthTexture()
+	{
+		assertFalse(DistantHorizonsMixinConnector.isIrisLoaded(resources(
+			"net/irisshaders/iris/api/v0/IrisApi.class")));
+		assertFalse(DistantHorizonsMixinConnector.isIrisLoaded(resources()));
+	}
+
+	@Test
+	void actualIrisFramebufferLeavesDepthAllocationToIris()
+	{
+		assertTrue(DistantHorizonsMixinConnector.isIrisLoaded(resources(
+			"net/irisshaders/iris/api/v0/IrisApi.class",
+			"net/coderbot/iris/rendertarget/IRenderTargetExt.class")));
+	}
+
+	private static ClassLoader resources(String... names)
+	{
+		Set<String> available = Set.of(names);
+		return new ClassLoader(null)
+		{
+			@Override
+			public URL getResource(String name)
+			{
+				return available.contains(name) ? DistantHorizonsMixinConnectorTest.class.getResource(
+					"DistantHorizonsMixinConnectorTest.class") : null;
+			}
+		};
+	}
+}
diff --git a/forge112/src/test/java/com/seibel/distanthorizons/forge112/modAccessor/ImpetusAccessorTest.java b/forge112/src/test/java/com/seibel/distanthorizons/forge112/modAccessor/ImpetusAccessorTest.java
new file mode 100644
index 000000000..32e0605a8
--- /dev/null
+++ b/forge112/src/test/java/com/seibel/distanthorizons/forge112/modAccessor/ImpetusAccessorTest.java
@@ -0,0 +1,48 @@
+package com.seibel.distanthorizons.forge112.modAccessor;
+
+import com.seibel.distanthorizons.common.commonMixins.IFramebufferDepthTexture;
+import net.irisshaders.iris.api.v0.IrisApi;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class ImpetusAccessorTest
+{
+	@AfterEach
+	void resetShaderState()
+	{
+		IrisApi.State.shaders = false;
+		IrisApi.State.shadow = false;
+	}
+
+	@Test
+	void shaderStateIsReadLiveThroughThePublicApi()
+	{
+		ImpetusAccessor accessor = new ImpetusAccessor();
+		assertEquals("Impetus", accessor.getModName());
+		assertFalse(accessor.isShaderPackInUse());
+		assertFalse(accessor.isRenderingShadowPass());
+		IrisApi.State.shaders = true;
+		assertTrue(accessor.isShaderPackInUse());
+		IrisApi.State.shadow = true;
+		assertTrue(accessor.isRenderingShadowPass());
+		IrisApi.State.shaders = false;
+		IrisApi.State.shadow = false;
+		assertFalse(accessor.isShaderPackInUse());
+		assertFalse(accessor.isRenderingShadowPass());
+		assertFalse(accessor.isReverseZDuringShaders());
+		assertFalse(accessor.supportsMultiBackend());
+		assertTrue(accessor.getDelayedSetupComplete());
+	}
+
+	@Test
+	void readsDepthFromDhsFramebufferWithoutIrisInternals()
+	{
+		ImpetusAccessor accessor = new ImpetusAccessor();
+		IFramebufferDepthTexture framebuffer = () -> 42;
+		assertEquals(42, accessor.getFramebufferDepthTextureId(framebuffer));
+		assertEquals(-1, accessor.getFramebufferDepthTextureId(new Object()));
+		assertEquals(-1, accessor.getFramebufferDepthTextureId(null));
+	}
+}
diff --git a/forge112/src/test/java/net/irisshaders/iris/api/v0/IrisApi.java b/forge112/src/test/java/net/irisshaders/iris/api/v0/IrisApi.java
new file mode 100644
index 000000000..1458f7c67
--- /dev/null
+++ b/forge112/src/test/java/net/irisshaders/iris/api/v0/IrisApi.java
@@ -0,0 +1,25 @@
+package net.irisshaders.iris.api.v0;
+
+// Test-only API contract; no shader implementation or OpenGL context is needed.
+public interface IrisApi
+{
+	static IrisApi getInstance()
+	{
+		return State.INSTANCE;
+	}
+
+	boolean isShaderPackInUse();
+	boolean isRenderingShadowPass();
+
+	final class State
+	{
+		public static boolean shaders;
+		public static boolean shadow;
+		private static final IrisApi INSTANCE = new IrisApi()
+		{
+			@Override public boolean isShaderPackInUse() { return shaders; }
+			@Override public boolean isRenderingShadowPass() { return shadow; }
+		};
+		private State() { }
+	}
+}
