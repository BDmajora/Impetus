impetus.options.extras.vertical_sync.name=Vertical Sync
impetus.options.extras.vertical_sync.tooltip=Matches the frame rate to your monitor's refresh rate to remove screen tearing. Adaptive does the same but turns itself off when the game falls below the refresh rate, which avoids stutter. Adaptive appears only when your graphics driver supports it.
impetus.options.extras.vertical_sync.adaptive=Adaptive

impetus.options.extras.steady_debug_hud.name=Steady F3 Screen
impetus.options.extras.steady_debug_hud.tooltip=Updates the F3 debug text a few times per second instead of every frame, which makes it easier to read and slightly faster.

impetus.options.extras.panini.name=Panini Projection
impetus.options.extras.panini.tooltip=Reduces the stretching at the edges of the screen at high field of view settings. Turns off while a shader pack is on.

impetus.options.extras.advanced_item_tooltips.name=Advanced Item Tooltips
impetus.options.extras.advanced_item_tooltips.tooltip=Shows each item's ID and durability in its tooltip. This is the same setting as F3 + H.
impetus.options.extras.mod_name_tooltip.name=Mod Name Tooltip
impetus.options.extras.mod_name_tooltip.tooltip=Shows which mod an item comes from at the bottom of its tooltip.
impetus.options.extras.zoom.enabled.name=Zoom
impetus.options.extras.zoom.enabled.tooltip=Zooms in while you hold the zoom key. The key is C by default and can be changed under Controls.
impetus.options.extras.zoom.level.name=Zoom Strength
impetus.options.extras.zoom.level.tooltip=How far the view zooms in.
impetus.options.extras.zoom.smooth_camera.name=Smooth Camera While Zoomed
impetus.options.extras.zoom.smooth_camera.tooltip=Smooths camera movement while zoomed, which makes aiming easier.
impetus.options.extras.zoom.hide_hand.name=Hide Hand While Zoomed
impetus.options.extras.zoom.hide_hand.tooltip=Hides your hand and held item while zoomed.

