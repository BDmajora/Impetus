impetus.options.extras.render.item_frames.name=Item Frames
impetus.options.extras.render.item_frames.tooltip=Draws item frames and the items inside them.
impetus.options.extras.render.armor_stands.name=Armor Stands
impetus.options.extras.render.armor_stands.tooltip=Draws armor stands. Their name tags still show.
impetus.options.extras.render.paintings.name=Paintings
impetus.options.extras.render.paintings.tooltip=Draws paintings.
impetus.options.extras.render.player_name_tag.name=Player Name Tags
impetus.options.extras.render.player_name_tag.tooltip=Shows names above other players.
impetus.options.extras.render.dropped_items.name=Fancy Dropped Items
impetus.options.extras.render.dropped_items.tooltip=Draws a dropped stack as several items piled together. When off each stack is drawn as a single item.
impetus.options.extras.render.beacons.name=Beacon Beams
impetus.options.extras.render.beacons.tooltip=Draws beacon beams.

impetus.options.extras.budget.mode.name=Render Budget
impetus.options.extras.budget.mode.tooltip=Skips drawing distant mobs and some decorative particles that you are unlikely to notice.\n\nPerformance: shows under half of decorative particles and hides idle mobs past 72 blocks.\nBalanced: shows about two thirds of decorative particles and hides idle mobs past 96 blocks.\nQuality: keeps every particle and only hides idle mobs past 128 blocks.\n\nPlayers, mobs within 32 blocks and named, glowing or ridden mobs are never hidden.
impetus.options.extras.budget_profile.quality=Quality
impetus.options.extras.budget_profile.balanced=Balanced
impetus.options.extras.budget_profile.performance=Performance

impetus.options.extras.booster.enabled.name=GPU Booster
impetus.options.extras.booster.enabled.tooltip=Speeds up how drawing work is handed to the graphics card. Leave this on unless you see rendering glitches.


impetus.options.extras.parallel.enabled.name=Multithreaded Ticking
impetus.options.extras.parallel.enabled.tooltip=Ticks mobs and crops across several CPU cores in singleplayer. Players, projectiles and a few sensitive entities always stay on the main thread.\n\nTakes effect after a restart.

impetus.options.extras.baked.enabled.name=Fast Chests & Signs
impetus.options.extras.baked.enabled.tooltip=Draws chests, ender chests, signs, beds and shulker boxes as part of the world instead of one at a time, which can greatly raise frame rates in rooms full of storage. Opening animations still play.


impetus.options.extras.occlusion.enabled.name=Hide Entities Behind Walls
impetus.options.extras.occlusion.enabled.tooltip=Skips drawing armor stands, mobs, chests and other objects that are hidden behind walls. Glowing entities are always drawn.
impetus.options.extras.occlusion.pause_hidden.name=Pause Hidden Armor Stands
impetus.options.extras.occlusion.pause_hidden.tooltip=Armor stands hidden behind walls skip their client tick but still follow the server's moves.
impetus.options.extras.leaves.culling_mode.name=Leaf Culling
impetus.options.extras.leaves.culling_mode.tooltip=Skips leaf faces that cannot be seen. Default draws every face. Check Surrounding hides only fully enclosed faces and looks the same. Depth also thins the inside of thick canopies for more speed.
impetus.options.extras.leaf_culling.default=Default
impetus.options.extras.leaf_culling.check=Check Surrounding
impetus.options.extras.leaf_culling.depth=Depth


